---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);

const lead = {
  name: 'Runtime2Test: turning live Java objects into replayable tests',
  url: 'https://github.com/alexli-77/Runtime2Test',
  image: '/assets/github/runtime2test.png',
  summary:
    'Captures real runtime object behavior and converts it into test code by combining ProDJ-style serialization with LLM generation. The research thread behind my Ph.D. work.',
  tags: 'Java · LLM · Software Testing',
};

const projects = [
  { name: 'KDS', kind: 'Systems', repo: 'KDS', image: 'kds', tags: 'Go · Kubernetes',
    summary: 'A policy-based dynamic scheduler for Kubernetes that rebalances stateful and stateless workloads safely.' },
  { name: 'UniMap Condor', kind: 'Tool', repo: 'unimap-condor', image: 'unimap-condor', tags: 'React · MapLibre · OpenAlex',
    summary: 'An interactive university map combining rankings, research metrics, and advisor discovery.' },
  { name: 'Daily OS', kind: 'Agent', repo: 'daily-os-feishu', image: 'daily-os-feishu', tags: 'TypeScript · Swift · Agent',
    summary: 'A Mac-first workflow agent that gathers signals, plans the day, and reports back to Feishu.' },
  { name: 'Kestrel', kind: 'Reliability', repo: 'kestrel', image: 'kestrel', tags: 'JavaScript · Automation',
    summary: 'A small reliability companion that detects missed scheduled jobs and catches them up safely.' },
  { name: 'Knowledge Base Template', kind: 'Skill', repo: 'Leon-knowledgeBase-template', image: 'leon-knowledgebase-template', tags: 'Obsidian · Claude Code',
    summary: 'An Obsidian + Claude Code knowledge base with PARA routing and low-friction capture.' },
  { name: 'Skills for Self-Management', kind: 'Skill', repo: 'skills-self-management', image: 'skills-self-management', tags: 'Agent Skills · Planning',
    summary: 'Agent skills inspired by the 7 Habits for auditing plans, schedules, and blind spots.' },
];
---

<Base>
  <!-- Cover story: introduction -->
  <section class="cover" id="about">
    <div class="wrap">
      <div class="cover-head">
        <span class="kicker">Cover Story · About</span>
        <h1>Research-minded <em>engineer.</em> <span class="highlight">Systems-minded</span> <em>researcher.</em></h1>
      </div>

      <div class="lede">
        <p>
          I am a Ph.D. student in Computer Science at the{' '}
          <a href="https://www.umontreal.ca/en/" target="_blank" rel="noopener">Université de Montréal</a>,
          working with Benoit Baudry on how large language models can generate tests that actually catch bugs.
        </p>
        <p>
          Before academia I spent five years at 58.com in Beijing as a senior backend engineer,
          building search and recommendation infrastructure on Kubernetes. I still think like a production
          engineer: what breaks, how you'd know, and what it costs.
        </p>
      </div>

      <aside class="glance" aria-label="At a glance">
        <span class="kicker">At a glance</span>
        <dl>
          <div><dt>Now</dt><dd>Ph.D., Université de Montréal</dd></div>
          <div><dt>Focus</dt><dd>LLM-based test generation</dd></div>
          <div><dt>Before</dt><dd>58.com Search · 2018–2023</dd></div>
          <div><dt>Stack</dt><dd>Java · Go · Kubernetes · TS</dd></div>
        </dl>
        <a class="cta" href="/writing/">Read the notes →</a>
      </aside>
    </div>
  </section>

  <!-- Features: projects -->
  <section class="projects" id="projects">
    <div class="wrap">
      <div class="section-head">
        <h2>Projects <span>— selected work</span></h2>
        <span class="kicker">{String(projects.length + 1).padStart(2, '0')} entries</span>
      </div>

      <a class="lead-feature" href={lead.url} target="_blank" rel="noopener">
        <div class="frame"><img src={lead.image} alt="Runtime2Test banner" /></div>
        <div>
          <span class="kicker">Lead feature · Research</span>
          <h3>{lead.name}</h3>
          <p>{lead.summary}</p>
          <div class="tags">{lead.tags}</div>
          <span class="read-more">View repository</span>
        </div>
      </a>

      <div class="project-grid">
        {projects.map((p, i) => (
          <a class="card" href={`https://github.com/alexli-77/${p.repo}`} target="_blank" rel="noopener">
            <div class="frame"><img src={`/assets/github/${p.image}.png`} alt={`${p.name} banner`} loading="lazy" /></div>
            <span class="num">{String(i + 2).padStart(2, '0')} — {p.kind}</span>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
            <div class="tags">{p.tags}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Writing: latest three posts from src/content/writing -->
  <section class="writing" id="writing">
    <div class="wrap">
      <div class="section-head">
        <h2>Writing <span>— notes &amp; essays</span></h2>
        <span class="kicker">Blog</span>
      </div>
      <PostList posts={posts} />
      <a class="all-posts" href="/writing/">All writing →</a>
    </div>
  </section>
</Base>
