---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Léon`} description={post.data.dek} type="article" publishedTime={post.data.date}>
  <article class="article">
    <div class="wrap">
      <header class="article-head">
        <span class="kicker">{post.data.kind}{post.data.draft && ' · Draft'}</span>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.dek}</p>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>{readingTime(post)} read</span>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <a class="back" href="/writing/">← All writing</a>
    </div>
  </article>
</Base>
