---
import { localize, ui, type Lang } from '../i18n';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = ui[lang];
---

{
  posts.length === 0 ? (
    <p class="empty">{t.empty}</p>
  ) : (
    posts.map((post) => (
      <a class="post" href={localize(lang, `/writing/${post.id}/`)}>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <div>
          <h3>
            {post.data.title}
            {post.data.draft && <span class="draft-badge">{t.draft.toUpperCase()}</span>}
          </h3>
          <p>{post.data.dek}</p>
        </div>
        <span class="meta">
          {t.minutes(readingTime(post))} · {t.kinds[post.data.kind]}
        </span>
      </a>
    ))
  )
}
