---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';
import { brandIcons, type Brand } from '../icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Fill in a value to show it on the page; empty entries are hidden.
const EMAIL = 'yang.li.9@umontreal.ca';
const WHATSAPP = ''; // e.g. '+1-514-555-0100'
const socials: { brand: Brand; label: string; url: string }[] = [
  { brand: 'linkedin', label: 'LinkedIn', url: '' },
  { brand: 'github', label: 'GitHub', url: 'https://github.com/alexli-77' },
  { brand: 'x', label: 'X', url: '' },
  { brand: 'facebook', label: 'Facebook', url: '' },
  { brand: 'instagram', label: 'Instagram', url: '' },
].filter((s) => s.url);

const copy = {
  en: {
    title: 'Contact — Léon',
    description: 'Get in touch with Yang (Léon) Li.',
    kicker: 'Correspondence · Contact',
    heading: 'Contact',
    intro: "Let's get to know each other, or just drop me a line.",
    message: 'If you are looking to get a hold of me, you can drop me a message:',
    social: 'You can also reach out to me on any social media below.',
    copy: 'Copy',
    copied: 'Copied',
  },
  zh: {
    title: '联系 — Léon',
    description: '联系 Yang (Léon) Li。',
    kicker: '来信 · 联系',
    heading: '联系',
    intro: '认识一下吧，或者随时给我留言。',
    message: '如果你想联系我，可以直接给我发消息：',
    social: '你也可以通过下面的社交媒体找到我。',
    copy: '复制',
    copied: '已复制',
  },
}[lang];
---

<Base title={copy.title} description={copy.description}>
  <section class="cover contact">
    <div class="wrap">
      <div class="cover-head">
        <span class="kicker">{copy.kicker}</span>
        <h1>{copy.heading}</h1>
      </div>

      <div class="lede">
        <p>{copy.intro}</p>
        <p>{copy.message}</p>

        <ul class="reach">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="2.5" y="5" width="19" height="14" rx="1" />
              <path d="m3 6 9 7 9-7" />
            </svg>
            <a class="spaced" href={`mailto:${EMAIL}`}>{EMAIL}</a>
            <button class="copy-btn" type="button" data-copy={EMAIL} data-done={copy.copied}>{copy.copy}</button>
          </li>
          {
            WHATSAPP && (
              <li>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={brandIcons.whatsapp} />
                </svg>
                <a class="spaced" href={`https://wa.me/${WHATSAPP.replace(/\D/g, '')}`} target="_blank" rel="noopener">
                  {WHATSAPP}
                </a>
              </li>
            )
          }
        </ul>

        <p>{copy.social}</p>

        <ul class="socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={brandIcons[s.brand]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = button.dataset.done ?? label;
      setTimeout(() => (button.textContent = label), 1600);
    });
  });
</script>
