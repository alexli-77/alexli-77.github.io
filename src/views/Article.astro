---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localize, ui, type Lang } from '../i18n';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = ui[lang];
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Léon`} description={post.data.dek} type="article" publishedTime={post.data.date}>
  <article class="article">
    <div class="wrap">
      <header class="article-head">
        <span class="kicker">{t.kinds[post.data.kind]}{post.data.draft && ` · ${t.draft}`}</span>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.dek}</p>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>{t.minutes(readingTime(post))} {t.read}</span>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <a class="back" href={localize(lang, '/writing/')}>{t.backToWriting}</a>
    </div>
  </article>
</Base>
