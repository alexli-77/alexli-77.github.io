---
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import PostList from '../components/PostList.astro';
import Socials from '../components/Socials.astro';
import { localize, ui, type Lang } from '../i18n';
import { getPosts } from '../lib/posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const contact = localize(lang, '/contact/');

const copy = {
  en: {
    greeting: 'Hi, I’m',
    subtitle: 'Research-minded engineer. Systems-minded researcher.',
    cta: 'Contact me',
    workTitle: 'Work',
    workSub: '— industry projects',
    productsTitle: 'AI Products',
    productsSub: '— built and shipped',
    entries: 'entries',
    readCase: 'Read the case study',
    work: {
      wcs: ['Industry · Cloud search', 'WCS: a multi-tenant cloud search platform at 58.com', 'Consolidated dozens of separately deployed vertical search systems into one platform on Kubernetes: 4 clusters, 396 servers, 300+ businesses, 200k+ peak QPS.'],
      kds: ['Industry · Systems · Patent', 'KDS: a self-adaptive rebalancer for Kubernetes', 'A control loop that keeps Pods evenly spread without an operator. In tests it cut the spread from 2–30 Pods per node to 5–6. Granted Chinese invention patent CN112181605B.'],
      suggest: ['Industry · Search engine', 'WCS Suggest: real-time query auto-completion', 'Characters, pinyin or initials in, top 20 suggestions out. I built its real-time indexing, so new and deleted suggestions take effect without a rebuild.'],
    },
    products: {
      'Daily OS': ['Agent', 'A Mac-first workflow agent that gathers signals, plans the day, and reports back to Feishu.'],
      DocuEngine: ['Product', 'An AI document engine that turns your facts into filing-ready legal, immigration and business documents, exported as editable Word.'],
      'UniMap Condor': ['Tool', 'An interactive university map combining rankings, research metrics, and advisor discovery.'],
    },
  },
  zh: {
    greeting: '你好，我是',
    subtitle: '带着研究眼光的工程师，带着系统思维的研究者。',
    cta: '联系我',
    workTitle: '工作项目',
    workSub: '— 工业界',
    productsTitle: 'AI 产品',
    productsSub: '— 独立开发并上线',
    entries: '个',
    readCase: '阅读项目详情',
    work: {
      wcs: ['工业界 · 云搜索', 'WCS：58 同城的多租户云搜索平台', '把几十套各自部署的垂直搜索收敛成一个跑在 Kubernetes 上的平台：4 个集群、396 台服务器，承接 300+ 业务，峰值 QPS 20 万+。'],
      kds: ['工业界 · 系统 · 专利', 'KDS：Kubernetes 自适应负载均衡调度器', '不需要人值守的控制回路，让 Pod 始终均匀分布。实验中把每个节点 2–30 个 Pod 的悬殊分布收敛到 5–6 个。已获中国发明专利授权（CN112181605B）。'],
      suggest: ['工业界 · 搜索引擎', 'WCS 搜索提示：实时查询补全引擎', '输入汉字、拼音或首字母，返回最相关的 20 条提示。我实现了它的实时索引，新增和删除的提示词不用重建索引就能生效。'],
    },
    products: {
      'Daily OS': ['Agent', 'Mac 优先的工作流 Agent：汇集信号、规划每一天，并把结果发回飞书。'],
      DocuEngine: ['产品', 'AI 文书生成引擎：根据你提供的事实，生成可直接提交的法律、移民与商业文件，并导出可编辑的 Word。'],
      'UniMap Condor': ['工具', '交互式大学地图，整合排名、科研指标与导师发现。'],
    },
  },
}[lang];

// Work projects are closed source, so each links to its own page on this site. Lead features alternate image left / right.
const work = [
  { key: 'wcs', href: '/projects/wcs-cloud-search/', src: '/assets/projects/wcs-cloud-search/cover.svg', alt: 'WCS cover: apps routed through route proxies to 4 search clusters', tags: 'Java · Kubernetes · Search' },
  { key: 'kds', href: '/projects/kds/', src: '/assets/projects/kds/cover.svg', alt: 'KDS: search Pods on a production Kubernetes cluster', tags: 'Go · Kubernetes · Scheduling' },
  { key: 'suggest', href: '/projects/wcs-suggest/', src: '/assets/projects/wcs-suggest/cover.svg', alt: 'WCS Suggest cover: typing bao suggests 宝马X5', tags: 'C++ · FST · Real-time indexing' },
] as const;

// Products link to their live sites; covers are real screenshots under /assets/projects/.
const products = [
  { name: 'Daily OS', url: 'https://alexli-77.github.io/daily-os/', src: '/assets/projects/daily-os/cover.svg', tags: 'TypeScript · Swift · Agent' },
  { name: 'DocuEngine', url: 'https://www.docuengineai.com/', src: '/assets/projects/docuengine/cover.svg', tags: 'React · Gemini · Supabase' },
  { name: 'UniMap Condor', url: 'https://www.unimapcondor.com/', src: '/assets/projects/unimap/cover.svg', tags: 'React · MapLibre · OpenAlex' },
] as const;
---

<Base>
  <!-- Hero: greeting, intro, contact; illustration on the right -->
  <section class="hero" id="about">
    <div class="wrap">
      <div class="hero-text">
        <h1>{copy.greeting} Lé<em>o</em>n</h1>
        <p class="hero-sub">{copy.subtitle}</p>

        {
          lang === 'en' ? (
            <div class="lede">
              <p>
                I'm a Ph.D. candidate in Computer Science at Université de Montréal and a research intern at Polytechnique
                Montréal. I study AI agents: their trajectories, their energy use, and how to verify what they do. My goal
                is agents that are more transparent and more efficient. Before that, I spent 7+ years as a senior backend
                engineer, designing cloud search architecture.
              </p>
              <p>
                I also build AI products on my own, like{' '}
                <a href="https://www.docuengineai.com/" target="_blank" rel="noopener">DocuEngine</a> and{' '}
                <a href="https://www.unimapcondor.com/" target="_blank" rel="noopener">UniMap Condor</a>. Have an idea?
                Let's talk.
              </p>
            </div>
          ) : (
            <div class="lede">
              <p>
                我是蒙特利尔大学计算机博士候选人，也在 Polytechnique Montréal 实习。我研究 AI Agent
                的运行轨迹、能耗与可观测性验证，目标是让 Agent 更透明、更高效。读博前，我做了 7
                年多资深后端开发，负责云搜索服务的架构设计。
              </p>
              <p>
                我也独立开发 AI 产品，比如
                <a href="https://www.docuengineai.com/" target="_blank" rel="noopener">DocuEngine</a> 和
                <a href="https://www.unimapcondor.com/" target="_blank" rel="noopener">UniMap Condor</a>。有想法？欢迎来聊。
              </p>
            </div>
          )
        }

        <!-- Contact me opens a drawer of links; without JS it's a plain link to /contact/ -->
        <div class="cta-row" data-drawer>
          <a class="cta" href={contact} aria-expanded="false" aria-controls="contact-drawer" data-drawer-toggle>{copy.cta}</a>
          <div class="cta-drawer" id="contact-drawer" inert>
            <Socials email />
          </div>
        </div>
      </div>

      <HeroArt lang={lang} />
    </div>
  </section>

  <!-- Work: industry projects, one lead feature each -->
  <section class="projects" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>{copy.workTitle} <span>{copy.workSub}</span></h2>
        <span class="kicker">{String(work.length).padStart(2, '0')} {copy.entries}</span>
      </div>

      {work.map((w, i) => {
        const [kicker, name, summary] = copy.work[w.key];
        return (
          <a class:list={['lead-feature', { flip: i % 2 === 1 }]} href={localize(lang, w.href)}>
            <div class="frame"><img src={w.src} alt={w.alt} loading={i === 0 ? 'eager' : 'lazy'} /></div>
            <div>
              <span class="kicker">{kicker}</span>
              <h3>{name}</h3>
              <p>{summary}</p>
              <div class="tags">{w.tags}</div>
              <span class="read-more">{copy.readCase}</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- AI products: live sites -->
  <section class="projects" id="products">
    <div class="wrap">
      <div class="section-head">
        <h2>{copy.productsTitle} <span>{copy.productsSub}</span></h2>
        <span class="kicker">{String(products.length).padStart(2, '0')} {copy.entries}</span>
      </div>

      <div class="project-grid">
        {products.map((p, i) => {
          const [kind, summary] = copy.products[p.name];
          return (
            <a class="card" href={p.url} target="_blank" rel="noopener">
              <div class="frame">
                <img src={p.src} alt={`${p.name} cover`} loading="lazy" />
              </div>
              <span class="num">{String(i + 1).padStart(2, '0')} — {kind}</span>
              <h3>{p.name}</h3>
              <p>{summary}</p>
              <div class="tags">{p.tags}</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Writing: latest three posts from src/content/writing -->
  <section class="writing" id="writing">
    <div class="wrap">
      <div class="section-head">
        <h2>{t.writingTitle} <span>{t.writingSub}</span></h2>
        <span class="kicker">{t.writingKicker}</span>
      </div>
      <PostList posts={posts} lang={lang} />
      <a class="all-posts" href={localize(lang, '/writing/')}>{t.allWriting}</a>
    </div>
  </section>
</Base>

<script>
  // Desktop: hover (or keyboard focus) opens the drawer; clicking the button goes to /contact/.
  // Touch: there's no hover, so a tap toggles the drawer instead.
  const row = document.querySelector<HTMLElement>('[data-drawer]');
  const toggle = row?.querySelector<HTMLElement>('[data-drawer-toggle]');
  const drawer = row?.querySelector<HTMLElement>('.cta-drawer');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (row && toggle && drawer) {
    let closeTimer: number | undefined;

    const setOpen = (open: boolean) => {
      clearTimeout(closeTimer);
      if (open === row.classList.contains('is-open')) return;
      row.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      drawer.inert = !open;
      // On phones the drawer wraps below the button; bring it on screen.
      if (open && !canHover) requestAnimationFrame(() => drawer.scrollIntoView({ block: 'nearest', behavior: 'smooth' }));
    };
    const closeSoon = () => {
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setOpen(false), 250);
    };

    if (canHover) {
      row.addEventListener('pointerenter', () => setOpen(true));
      row.addEventListener('pointerleave', closeSoon);
    } else {
      toggle.addEventListener('click', (event) => {
        event.preventDefault();
        setOpen(!row.classList.contains('is-open'));
      });
      document.addEventListener('click', (event) => {
        if (!row.contains(event.target as Node)) setOpen(false);
      });
    }
    // Keyboard focus only; a tap also focuses the button and must not double-toggle.
    row.addEventListener('focusin', (event) => {
      if ((event.target as HTMLElement).matches(':focus-visible')) setOpen(true);
    });
    row.addEventListener('focusout', (event) => {
      if (!row.contains(event.relatedTarget as Node)) closeSoon();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
